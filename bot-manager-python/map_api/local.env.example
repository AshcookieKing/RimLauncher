# Скопируйте в map_api/local.env и укажите DB_PASSWORD (файл в .gitignore — не коммитьте).
# Запуск: из корня репозитория: python -m map_api.app
# Если в логах GSSAPI / auth_gssapi_client: pip install mariadb и при необходимости MAP_API_DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=arma3_slserver
# Если жёлтые пропы «у нижней кромки», а в БД перепутаны восток/север по pos_x/pos_y: MAP_OBJECTS_SWAP_PLANE_AXES=1
#
# BattlEye RCON (когда HTTP к игре недоступен, а UDP к RConPort открыт с машины map_api):
# MAP_RCON_ENABLED=1
# MAP_RCON_HOST=127.0.0.1
# MAP_RCON_PORT=2306
# MAP_RCON_PASSWORD=your_rcon_password
# MAP_RCON_TIMEOUT_SEC=12
# опционально: MAP_RCON_CONNECT_TIMEOUT_SEC=8  MAP_RCON_INITIAL_CONNECT_ATTEMPTS=5
# Обязательно MAP_API_ADMIN_SECRET + заголовок X-Map-Admin-Key на странице /rcon
# pip install berconpy
# Пароль/порт из BattlEye: python -m map_api.sync_be_rcon  (или MAP_RCON_BE_CFG=путь\\к\\BEServer_x64.cfg)
# Проверка RCON без map_api: python scripts/bercon_rcon_test.py --be-cfg C:\\a3server\\BattlEye\\BEServer_x64.cfg
#
# Разведка → Discord: recon_bot (recon_bot/app.py). Задайте MAP_DISCORD_BRIDGE_TOKEN и тот же URL (PORT = RECON_HTTP_PORT в recon_bot/.env).
# MAP_DISCORD_BRIDGE_URL=http://127.0.0.1:8765/api/recon/outpost
# MAP_DISCORD_BRIDGE_TOKEN=случайная_строка_как_пароль
