@echo off
echo ========================================
echo Установка зависимостей Node.js для ботов
echo ========================================
echo.

cd /d "%~dp0"
cd ..

if not exist "package.json" (
    echo ОШИБКА: package.json не найден!
    echo Убедитесь, что вы запускаете скрипт из правильной папки.
    pause
    exit /b 1
)

echo Установка зависимостей из package.json...
call npm install

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ========================================
    echo ✅ Зависимости успешно установлены!
    echo ========================================
) else (
    echo.
    echo ========================================
    echo ❌ Ошибка при установке зависимостей
    echo ========================================
)

pause

