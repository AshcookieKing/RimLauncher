							class Attributes
							{
								init="call{this addAction[""<t color='#eeff00ff'>Наземная техника</t>"",{_this call LHP_fnc_initSpawner},""RC"",0,false,false,"""",'(alive player) && !dialog && player distance _target < 3'];};     " \n "     " \n "this addAction [""Вернуть технику с платформы"",       " \n "  {      " \n "   _pos = Spawn_Pad_C1 modelToWorld [0,0,0];      " \n "   _NearVeh = nearestObjects [_pos, [""landVehicle"", ""Air"", ""Ship""], 15];      " \n "   {      " \n "    deleteVehicle _x;      " \n "    _curVeh = typeOf _x;      " \n "    _curVehVar = format [""%1_Var"", _curVeh];      " \n "    _curVehHave = (Spawn_Pad_C1 getVariable [_curVehVar, 0]) + 1;      " \n "    [Spawn_Pad_C1, [_curVehVar, _curVehHave]] remoteExec [""setVariable"", 0];      " \n "   } forEach _NearVeh;      " \n "  }, [], 1.5, false, false, """", ""true"", 5];      " \n "      " \n "this addAction [""Обслуживание техники с платформы"",       " \n " {      " \n "  _veh = nearestObjects [Spawn_Pad_C1, [""car"", ""tank"", ""helicopter"", ""plane""], 15] select 0;       " \n "  [_veh, 1] remoteExec [""setFuel"", 0];       " \n "  [_veh, 0] remoteExec [""setDamage"", 0];       " \n "  [_veh, 1] remoteExec [""setVehicleAmmo"", 0];       " \n " }, [], 6, false, false, """", ""true"", 5];";
							};
							id=329;
							type="3AS_T_Screen";
							atlOffset=0.065275192;
						};
